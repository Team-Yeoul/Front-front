# 백엔드 주소 (웹의 NEXT_PUBLIC_API_BASE_URL과 같은 값)
EXPO_PUBLIC_API_BASE_URL=
# Google 로그인: 서버가 ID Token audience로 확인하는 웹 클라이언트 ID (웹의 NEXT_PUBLIC_GOOGLE_CLIENT_ID와 같은 값)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google 로그인: iOS 클라이언트 ID와 그 URL 스킴(com.googleusercontent.apps.xxx)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
